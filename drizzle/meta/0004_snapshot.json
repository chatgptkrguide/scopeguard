        "change_orders_status_known": {
          "name": "change_orders_status_known",
          "value": "status IN ('draft', 'sent', 'paid', 'waived', 'cancelled')"
        },
        "change_orders_amount_not_negative": {
          "name": "change_orders_amount_not_negative",
          "value": "\"change_orders\".\"amount_cents\" >= 0"
        },
        "change_orders_hours_positive": {
          "name": "change_orders_hours_positive",
          "value": "\"change_orders\".\"hours\" > 0 AND \"change_orders\".\"extra_days\" >= 0"
        },
        "change_orders_sent_has_invoice": {
          "name": "change_orders_sent_has_invoice",
          "value": "\"change_orders\".\"status\" <> 'sent' OR (\"change_orders\".\"paypal_invoice_id\" IS NOT NULL AND \"change_orders\".\"sent_at\" IS NOT NULL)"
        },
        "change_orders_paid_has_dates": {
          "name": "change_orders_paid_has_dates",
          "value": "\"change_orders\".\"status\" <> 'paid' OR (\"change_orders\".\"paid_at\" IS NOT NULL AND \"change_orders\".\"sent_at\" IS NOT NULL AND \"change_orders\".\"paid_at\" >= \"change_orders\".\"sent_at\")"
        },
        "change_orders_billed_amount_positive": {
          "name": "change_orders_billed_amount_positive",
          "value": "\"change_orders\".\"status\" NOT IN ('sent', 'paid') OR \"change_orders\".\"amount_cents\" > 0"
        }
      }
